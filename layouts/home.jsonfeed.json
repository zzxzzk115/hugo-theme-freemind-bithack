{{- /* JSON Feed 1.1 (https://jsonfeed.org/version/1.1) */ -}}
{{- $posts := first (site.Params.feed.limit | default 20) (partial "func/articles.html" .) }}
{{- $full := ne site.Params.feed.fullText false }}
{{- $items := slice }}
{{- range $posts }}
  {{- $tags := slice }}{{ range .GetTerms "tags" }}{{ $tags = $tags | append (partialCached "func/term-title.html" . .RelPermalink) }}{{ end }}
  {{- $item := dict "id" .Permalink "url" .Permalink "title" .Title "date_published" (.Date.Format "2006-01-02T15:04:05Z07:00") "date_modified" (.Lastmod.Format "2006-01-02T15:04:05Z07:00") "summary" (.Summary | plainify | htmlUnescape | strings.TrimSpace) "tags" $tags }}
  {{- if $full }}{{ $item = merge $item (dict "content_html" (.Content | absURL)) }}{{ end }}
  {{- $items = $items | append $item }}
{{- end }}
{{- $feed := dict "version" "https://jsonfeed.org/version/1.1" "title" site.Title "home_page_url" .Permalink "language" (site.Language.Locale | default site.Language.Lang) "items" $items }}
{{- with .OutputFormats.Get "jsonfeed" }}{{ $feed = merge $feed (dict "feed_url" .Permalink) }}{{ end }}
{{- with site.Params.description }}{{ $feed = merge $feed (dict "description" .) }}{{ end }}
{{- with site.Params.author }}{{ $feed = merge $feed (dict "authors" (slice (dict "name" .))) }}{{ end }}
{{- with site.Params.logo }}{{ $feed = merge $feed (dict "icon" (. | absURL)) }}{{ end }}
{{- $feed | jsonify (dict "indent" "  ") }}
